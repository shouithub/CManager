CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=your_secret_key_here
DEBUG=True
# Database Configuration (Defaults to SQLite if not set)
# DB_ENGINE=django.db.backends.mysql
# 生产环境必填：可用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成
CREDENTIAL_ENCRYPTION_KEY=
CACHE_BACKEND=locmem
# 生产环境请改为 redis；非 DEBUG 模式会强制检查
REDIS_URL=redis://127.0.0.1:6379/1
# 以下 HTTPS 措施仅在 IS_NGINX_PROXY=True 时生效：
# Django 默认不提供 HTTPS，直连端口部署时保持关闭，避免登录失效或跳转死循环。
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# 只有在可信反向代理会覆盖这些请求头时才开启
# 反向代理主开关：使用 Nginx/Caddy 等反代时设为 True；直连端口部署保持 False
IS_NGINX_PROXY=True
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PROTO=True
USE_X_FORWARDED_FOR=True
# DB_NAME=cmanager
# DB_USER=root
# DB_PASSWORD=password
# DB_HOST=127.0.0.1
# DB_PORT=3306

ADMIN_CONTACT_EMAIL=admin@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
